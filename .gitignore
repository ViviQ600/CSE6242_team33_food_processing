# ==============================================================================
# Python & Bytecode Artifacts
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so

# ==============================================================================
# Virtual Environments & Packaging
# ==============================================================================
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
build/
dist/
*.egg-info/
*.egg

# ==============================================================================
# Jupyter Notebook & IDE Settings
# ==============================================================================
.ipynb_checkpoints
profile_default/
ipython_config.py
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ==============================================================================
# Data Directories (Exclude Massive Raw/Full Files, Track Gitkeep & Sample)
# ==============================================================================
# Ignore raw data archives (GB scale)
data/raw/*
!data/raw/.gitkeep

# Ignore full-scale processed datasets (over 50-100 MB limits)
data/processed/*
!data/processed/.gitkeep

# Whitelist small test sample for collaborative dev on GitHub
!data/processed/*sample*

# ==============================================================================
# Results, Visuals & Large Model Binaries
# ==============================================================================
results/figures/*
!results/figures/.gitkeep
results/tables/*
!results/tables/.gitkeep
results/models/*
!results/models/.gitkeep
*.log