            <column caption='Param_NOVA4_Threshold' datatype='real' name='[Parameter 13039443833724957]' param-domain-type='range' role='measure' type='quantitative' value='0.16043725535221232'>
              <calculation class='tableau' formula='0.16043725535221232' />
