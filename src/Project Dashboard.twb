          <datasources>
            <datasource caption='tableau_products' name='federated.1tjvipp1mqvyp916upkvw0hj7oht' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Remove' caption='Preservatives' datatype='boolean' name='[Param_Remove_Emulsifiers (copy)_13039443832381461]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
              <aliases>
                <alias key='false' value='Keep' />
                <alias key='true' value='Remove' />
              </aliases>
            </column>
            <column alias='Remove' caption='Artificial Color' datatype='boolean' name='[Param_Remove_Emulsifiers (copy)_13039443832819737]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
              <aliases>
                <alias key='false' value='Keep' />
                <alias key='true' value='Remove' />
              </aliases>
            </column>
            <column alias='Remove' caption='Flavor Enhancers' datatype='boolean' name='[Param_Remove_Preservatives (copy)_13039443832676375]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
              <aliases>
                <alias key='false' value='Keep' />
                <alias key='true' value='Remove' />
              </aliases>
            </column>
            <column caption='Sugar Cut %' datatype='real' default-format='p0.00%' name='[Parameter 13039443461939200]' param-domain-type='range' role='measure' type='quantitative' value='0.84999999999999998'>
              <calculation class='tableau' formula='0.84999999999999998' />
              <range granularity='0.05' max='1.0' min='0.0' />
            </column>
            <column caption='Sodium Cut %' datatype='real' default-format='p0.00%' name='[Parameter 13039443464347649]' param-domain-type='range' role='measure' type='quantitative' value='0.0'>
              <calculation class='tableau' formula='0.0' />
              <range granularity='0.05' max='0.5' min='0.0' />
            </column>
            <column caption='Sat. Fat Cut %' datatype='real' default-format='p0.00%' name='[Parameter 13039443466125314]' param-domain-type='range' role='measure' type='quantitative' value='0.0'>
              <calculation class='tableau' formula='0.0' />
              <range granularity='0.05' max='0.5' min='0.0' />
            </column>
            <column alias='Remove' caption='Emulsifiers' datatype='boolean' name='[Parameter 13039443466584067]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
              <aliases>
                <alias key='false' value='Keep' />
                <alias key='true' value='Remove' />
              </aliases>
            </column>
            <column alias='Remove' caption='Sweeteners' datatype='boolean' name='[Parameter 13039443466829828]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
              <aliases>
                <alias key='false' value='Keep' />
                <alias key='true' value='Remove' />
              </aliases>
            </column>
            <column caption='Param_NOVA4_Threshold' datatype='real' name='[Parameter 13039443833724957]' param-domain-type='range' role='measure' type='quantitative' value='0.45556416433671104'>
              <calculation class='tableau' formula='0.45556416433671104' />
              <range max='1.0' min='0.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1tjvipp1mqvyp916upkvw0hj7oht'>
            <column caption='Dynamic NOVA 4 Prob' datatype='real' name='[Calculation_13039443473338374]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(0.0, MIN(1.0, ZN([pred_nova4_prob]) - (ZN([shap_sugars_nova]) * [Parameters].[Parameter 13039443461939200]) - (ZN([shap_sodium_nova]) * [Parameters].[Parameter 13039443464347649]) - (ZN([shap_satfat_nova]) * [Parameters].[Parameter 13039443466125314]) - (IF [Parameters].[Parameter 13039443466584067] THEN 0.1677712350655815 * ZN([has_emulsifier]) ELSE 0.0 END) - (IF [Parameters].[Parameter 13039443466829828] THEN 0.03033125115521329 * ZN([has_sweetener]) ELSE 0.0 END) - (IF [Parameters].[Param_Remove_Emulsifiers (copy)_13039443832381461] THEN 0.02326274703741176 * ZN([has_preservative]) ELSE 0.0 END) - (IF [Parameters].[Param_Remove_Preservatives (copy)_13039443832676375] THEN 0.09077031125379285 * ZN([has_flavor_enhancer]) ELSE 0.0 END) - (IF [Parameters].[Param_Remove_Emulsifiers (copy)_13039443832819737] THEN 0.09122154489674218 * ZN([has_artificial_color]) ELSE 0.0 END)))' />
            </column>
            <column caption='Dynamic Nutri-Score Points' datatype='real' name='[Calculation_13039443474284552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([nutriscore_score_final]) &#13;&#10;- (ZN([nutri_sugar_penalty_pts]) * [Parameters].[Parameter 13039443461939200]) &#13;&#10;- (ZN([nutri_sodium_penalty_pts]) * [Parameters].[Parameter 13039443464347649]) &#13;&#10;- (ZN([saturated-fat_100g] / 1.0) * [Parameters].[Parameter 13039443466125314])' />
            </column>
            <column caption='Reformulation_Status' datatype='string' name='[Calculation_13039443840737313]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF COUNTD([product_name]) &lt;&gt; 1 THEN &quot;&quot; ELSE IF ([Parameters].[Parameter 13039443461939200] + [Parameters].[Parameter 13039443464347649] + [Parameters].[Parameter 13039443466125314]) &gt;= 0.80 THEN &quot;⚠️ OVER-CUT ALERT&quot; ELSEIF AVG([Calculation_13039443473338374]) &lt; 0.40 AND (IF ISNULL(AVG([nutriscore_score_final])) THEN IFNULL(MIN([nutriscore_grade_final]), &quot;Unknown&quot;) ELSE IF AVG([Calculation_13039443474284552]) &lt;= -1 THEN &quot;A&quot; ELSEIF AVG([Calculation_13039443474284552]) &lt;= 2 THEN &quot;B&quot; ELSEIF AVG([Calculation_13039443474284552]) &lt;= 10 THEN &quot;C&quot; ELSEIF AVG([Calculation_13039443474284552]) &lt;= 18 THEN &quot;D&quot; ELSE &quot;E&quot; END END) IN (&quot;A&quot;, &quot;B&quot;) THEN &quot;🟢 HEALTHY BENCHMARK&quot; ELSEIF AVG([Calculation_13039443473338374]) &lt; [Parameters].[Parameter 13039443833724957] THEN &quot;🟡 PARTIAL REFORMULATION&quot; ELSE &quot;🔴 ULTRA-PROCESSED&quot; END END' />
            </column>
            <column caption='KPI Product Header' datatype='string' name='[Calculation_202611020001]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF COUNTD([product_name]) = 1 THEN IFNULL(MIN([product_name]), &quot;Unknown Product&quot;) ELSE &quot;Please select one product&quot; END' />
            </column>
            <column caption='KPI NOVA Probability Comparison' datatype='string' name='[Calculation_202611020002]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF COUNTD([product_name]) = 1 THEN (&quot;NOVA Group: &quot; + (IF COUNTD([pred_nova_group]) &gt; 1 THEN &quot;Mixed&quot; ELSE IF COUNTD([pred_nova_group]) = 0 THEN &quot;Unknown&quot; ELSE &quot;NOVA &quot; + STR(MIN([pred_nova_group])) END END) + &quot; -&gt; &quot; + (IF [Parameters].[Parameter 13039443461939200] = 0 AND [Parameters].[Parameter 13039443464347649] = 0 AND [Parameters].[Parameter 13039443466125314] = 0 AND [Parameters].[Parameter 13039443466584067] = FALSE AND [Parameters].[Parameter 13039443466829828] = FALSE AND [Parameters].[Param_Remove_Emulsifiers (copy)_13039443832381461] = FALSE AND [Parameters].[Param_Remove_Emulsifiers (copy)_13039443832819737] = FALSE AND [Parameters].[Param_Remove_Preservatives (copy)_13039443832676375] = FALSE THEN (IF COUNTD([pred_nova_group]) &gt; 1 THEN &quot;Mixed&quot; ELSE IF COUNTD([pred_nova_group]) = 0 THEN &quot;Unknown&quot; ELSE &quot;NOVA &quot; + STR(MIN([pred_nova_group])) END END) ELSEIF AVG([Calculation_13039443473338374]) &gt;= [Parameters].[Parameter 13039443833724957] THEN &quot;NOVA 4&quot; ELSEIF COUNTD([pred_nova_group]) &gt; 1 THEN &quot;Mixed&quot; ELSE IFNULL(&quot;NOVA &quot; + STR(MIN([pred_nova_group])), &quot;Unknown&quot;) END) + &quot; | NOVA 4 Prob: &quot; + STR(ROUND(AVG([pred_nova4_prob]) * 100, 1)) + &quot;% -&gt; &quot; + STR(ROUND(AVG([Calculation_13039443473338374]) * 100, 1)) + &quot;%&quot;) ELSE &quot;&quot; END' />
            </column>
            <column caption='KPI Nutri-Score Comparison' datatype='string' name='[Calculation_202611020003]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF COUNTD([product_name]) = 1 THEN (&quot;Nutri-Score: &quot; + (IF COUNTD([nutriscore_grade_final]) &gt; 1 THEN &quot;Mixed&quot; ELSE IFNULL(MIN([nutriscore_grade_final]), &quot;Unknown&quot;) END) + &quot; -&gt; &quot; + (IF ISNULL(AVG([nutriscore_score_final])) THEN IF [Parameters].[Parameter 13039443461939200] = 0 AND [Parameters].[Parameter 13039443464347649] = 0 AND [Parameters].[Parameter 13039443466125314] = 0 THEN (IF COUNTD([nutriscore_grade_final]) &gt; 1 THEN &quot;Mixed&quot; ELSE IFNULL(MIN([nutriscore_grade_final]), &quot;Unknown&quot;) END) ELSE (IF COUNTD([nutriscore_grade_final]) &gt; 1 THEN &quot;Mixed&quot; ELSE IFNULL(MIN([nutriscore_grade_final]), &quot;Unknown&quot;) END) + &quot; (No Base Score)&quot; END ELSEIF [Parameters].[Parameter 13039443461939200] = 0 AND [Parameters].[Parameter 13039443464347649] = 0 AND [Parameters].[Parameter 13039443466125314] = 0 THEN (IF COUNTD([nutriscore_grade_final]) &gt; 1 THEN &quot;Mixed&quot; ELSE IFNULL(MIN([nutriscore_grade_final]), &quot;Unknown&quot;) END) ELSE IF AVG([Calculation_13039443474284552]) &lt;= -1 THEN &quot;A&quot; ELSEIF AVG([Calculation_13039443474284552]) &lt;= 2 THEN &quot;B&quot; ELSEIF AVG([Calculation_13039443474284552]) &lt;= 10 THEN &quot;C&quot; ELSEIF AVG([Calculation_13039443474284552]) &lt;= 18 THEN &quot;D&quot; ELSE &quot;E&quot; END END)) ELSE &quot;&quot; END' />
            </column>
            <column caption='KPI Grade Source' datatype='string' name='[Calculation_202611020004]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF COUNTD([product_name]) = 1 THEN (&quot;Grade Source: &quot; + (IF COUNTD([nutriscore_provenance]) &gt; 1 THEN &quot;Mixed&quot; ELSE IFNULL(MIN([nutriscore_provenance]), &quot;Unknown&quot;) END)) ELSE &quot;&quot; END' />
            </column>
