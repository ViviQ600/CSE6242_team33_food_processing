          </datasource-dependencies>
          <filter class='categorical' column='[federated.1tjvipp1mqvyp916upkvw0hj7oht].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1tjvipp1mqvyp916upkvw0hj7oht].[avg:has_emulsifier:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1tjvipp1mqvyp916upkvw0hj7oht].[avg:has_preservative:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1tjvipp1mqvyp916upkvw0hj7oht].[avg:has_sweetener:qk]&quot;' />
