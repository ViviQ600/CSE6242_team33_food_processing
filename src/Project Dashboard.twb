              <calculation class='tableau' formula='MAX(0.0, MIN(1.0, ZN([pred_nova4_prob]) - (ZN([shap_sugars_nova]) * [Parameters].[Parameter 13039443461939200]) - (ZN([shap_sodium_nova]) * [Parameters].[Parameter 13039443464347649]) - (ZN([shap_satfat_nova]) * [Parameters].[Parameter 13039443466125314]) - (IF [Parameters].[Parameter 13039443466584067] THEN 0.1677712350655815 * ZN([has_emulsifier]) ELSE 0.0 END) - (IF [Parameters].[Parameter 13039443466829828] THEN 0.03033125115521329 * ZN([has_sweetener]) ELSE 0.0 END) - (IF [Parameters].[Param_Remove_Emulsifiers (copy)_13039443832381461] THEN 0.02326274703741176 * ZN([has_preservative]) ELSE 0.0 END) - (IF [Parameters].[Param_Remove_Preservatives (copy)_13039443832676375] THEN 0.09077031125379285 * ZN([has_flavor_enhancer]) ELSE 0.0 END) - (IF [Parameters].[Param_Remove_Emulsifiers (copy)_13039443832819737] THEN 0.09122154489674218 * ZN([has_artificial_color]) ELSE 0.0 END)))' />
