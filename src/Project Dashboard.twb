          <datasource-dependencies datasource='federated.1tjvipp1mqvyp916upkvw0hj7oht'>
            <column caption='Impact_Sugar_%' datatype='real' default-format='p0.00%' name='[Calculation_13039443761553423]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(MAX(0.0, ZN([shap_sugars_nova]))) / (SUM(MAX(0.0, ZN([shap_sugars_nova]))) + SUM(MAX(0.0, ZN([shap_sodium_nova]))) + SUM(MAX(0.0, ZN([shap_satfat_nova]))) + SUM(MAX(0.0, ZN([shap_additives_nova]))) + 0.00001)' />
            </column>
            <column caption='Impact_Sodium_%' datatype='real' default-format='p0.00%' name='[Calculation_13039443761823760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(MAX(0.0, ZN([shap_sodium_nova]))) / (SUM(MAX(0.0, ZN([shap_sugars_nova]))) + SUM(MAX(0.0, ZN([shap_sodium_nova]))) + SUM(MAX(0.0, ZN([shap_satfat_nova]))) + SUM(MAX(0.0, ZN([shap_additives_nova]))) + 0.00001)' />
            </column>
            <column caption='Impact_SatFat_%' datatype='real' default-format='p0.00%' name='[Calculation_13039443762098193]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(MAX(0.0, ZN([shap_satfat_nova]))) / (SUM(MAX(0.0, ZN([shap_sugars_nova]))) + SUM(MAX(0.0, ZN([shap_sodium_nova]))) + SUM(MAX(0.0, ZN([shap_satfat_nova]))) + SUM(MAX(0.0, ZN([shap_additives_nova]))) + 0.00001)' />
            </column>
            <column caption='Impact_Additives_%' datatype='real' default-format='p0.00%' name='[Calculation_13039443762327570]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(MAX(0.0, ZN([shap_additives_nova]))) / (SUM(MAX(0.0, ZN([shap_sugars_nova]))) + SUM(MAX(0.0, ZN([shap_sodium_nova]))) + SUM(MAX(0.0, ZN([shap_satfat_nova]))) + SUM(MAX(0.0, ZN([shap_additives_nova]))) + 0.00001)' />
