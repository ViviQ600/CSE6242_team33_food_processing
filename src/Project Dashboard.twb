      <column caption='Total_UPF_Drivers' datatype='real' name='[Calculation_13039443761467406]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(MAX(0.0, ZN([shap_sugars_nova]))) + SUM(MAX(0.0, ZN([shap_sodium_nova]))) + SUM(MAX(0.0, ZN([shap_satfat_nova]))) + SUM(MAX(0.0, ZN([shap_additives_nova]))) + 0.00001' />
