      <table>
        <view>
          <datasources>
            <datasource caption='tableau_products' name='federated.1tjvipp1mqvyp916upkvw0hj7oht' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Remove' caption='Preservatives' datatype='boolean' name='[Param_Remove_Emulsifiers (copy)_13039443832381461]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
              <aliases>
                <alias key='false' value='Keep' />
                <alias key='true' value='Remove' />
              </aliases>
            </column>
            <column alias='Remove' caption='Artificial Color' datatype='boolean' name='[Param_Remove_Emulsifiers (copy)_13039443832819737]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
              <aliases>
                <alias key='false' value='Keep' />
                <alias key='true' value='Remove' />
              </aliases>
            </column>
            <column alias='Remove' caption='Flavor Enhancers' datatype='boolean' name='[Param_Remove_Preservatives (copy)_13039443832676375]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
              <aliases>
                <alias key='false' value='Keep' />
                <alias key='true' value='Remove' />
              </aliases>
            </column>
            <column caption='Sugar Cut %' datatype='real' default-format='p0.00%' name='[Parameter 13039443461939200]' param-domain-type='range' role='measure' type='quantitative' value='0.84999999999999998'>
              <calculation class='tableau' formula='0.84999999999999998' />
              <range granularity='0.05' max='1.0' min='0.0' />
            </column>
            <column caption='Sodium Cut %' datatype='real' default-format='p0.00%' name='[Parameter 13039443464347649]' param-domain-type='range' role='measure' type='quantitative' value='0.0'>
              <calculation class='tableau' formula='0.0' />
              <range granularity='0.05' max='0.5' min='0.0' />
            </column>
            <column caption='Sat. Fat Cut %' datatype='real' default-format='p0.00%' name='[Parameter 13039443466125314]' param-domain-type='range' role='measure' type='quantitative' value='0.0'>
              <calculation class='tableau' formula='0.0' />
              <range granularity='0.05' max='0.5' min='0.0' />
