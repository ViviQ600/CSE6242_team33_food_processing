      <column caption='Dynamic NOVA 4 Prob' datatype='real' name='[Calculation_13039443473338374]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX(0.0, MIN(1.0, ZN([pred_nova4_prob]) - (ZN([shap_sugars_nova]) * [Parameters].[Parameter 13039443461939200]) - (ZN([shap_sodium_nova]) * [Parameters].[Parameter 13039443464347649]) - (ZN([shap_satfat_nova]) * [Parameters].[Parameter 13039443466125314]) - (IF [Parameters].[Parameter 13039443466584067] THEN 0.20877546496580834 * ZN([has_emulsifier]) ELSE 0.0 END) - (IF [Parameters].[Parameter 13039443466829828] THEN 0.05161728063032965 * ZN([has_sweetener]) ELSE 0.0 END) - (IF [Parameters].[Param_Remove_Emulsifiers (copy)_13039443832381461] THEN 0.019974718949425197 * ZN([has_preservative]) ELSE 0.0 END) - (IF [Parameters].[Param_Remove_Preservatives (copy)_13039443832676375] THEN 0.10629109736221067 * ZN([has_flavor_enhancer]) ELSE 0.0 END)))' />
      </column>
      <column caption='Dynamic NOVA Group' datatype='string' name='[Calculation_13039443474153479]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 13039443461939200] = 0 AND [Parameters].[Parameter 13039443464347649] = 0 AND [Parameters].[Parameter 13039443466125314] = 0 AND [Parameters].[Parameter 13039443466584067] = FALSE AND [Parameters].[Parameter 13039443466829828] = FALSE AND [Parameters].[Param_Remove_Emulsifiers (copy)_13039443832381461] = FALSE AND [Parameters].[Param_Remove_Emulsifiers (copy)_13039443832819737] = FALSE AND [Parameters].[Param_Remove_Preservatives (copy)_13039443832676375] = FALSE THEN IF [pred_nova_group] = 1 THEN &quot;NOVA 1 (Unprocessed)&quot; ELSEIF [pred_nova_group] = 2 THEN &quot;NOVA 2 (Culinary)&quot; ELSEIF [pred_nova_group] = 3 THEN &quot;NOVA 3 (Processed)&quot; ELSE &quot;NOVA 4 (Ultra-Processed)&quot; END ELSEIF [Calculation_13039443473338374] &gt;= [Parameters].[Parameter 13039443833724957] THEN &quot;NOVA 4 (Ultra-Processed)&quot; ELSEIF [pred_nova_group] = 1 THEN &quot;NOVA 1 (Unprocessed)&quot; ELSEIF [pred_nova_group] = 2 THEN &quot;NOVA 2 (Culinary)&quot; ELSE &quot;NOVA 3 (Processed)&quot; END' />
      </column>
      <column caption='Dynamic Nutri-Score Points' datatype='real' name='[Calculation_13039443474284552]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([nutriscore_score_final]) &#13;&#10;- (ZN([nutri_sugar_penalty_pts]) * [Parameters].[Parameter 13039443461939200]) &#13;&#10;- (ZN([nutri_sodium_penalty_pts]) * [Parameters].[Parameter 13039443464347649]) &#13;&#10;- (ZN([saturated-fat_100g] / 1.0) * [Parameters].[Parameter 13039443466125314])' />
      </column>
      <column caption='Dynamic Nutri-Score Grade' datatype='string' name='[Calculation_13039443474423817]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 13039443461939200] = 0 AND [Parameters].[Parameter 13039443464347649] = 0 AND [Parameters].[Parameter 13039443466125314] = 0 AND [Parameters].[Parameter 13039443466584067] = FALSE AND [Parameters].[Parameter 13039443466829828] = FALSE AND [Parameters].[Param_Remove_Emulsifiers (copy)_13039443832381461] = FALSE AND [Parameters].[Param_Remove_Emulsifiers (copy)_13039443832819737] = FALSE AND [Parameters].[Param_Remove_Preservatives (copy)_13039443832676375] = FALSE THEN [nutriscore_grade_final] ELSEIF [Calculation_13039443474284552] &lt;= -1 THEN &quot;A&quot; ELSEIF [Calculation_13039443474284552] &lt;= 2 THEN &quot;B&quot; ELSEIF [Calculation_13039443474284552] &lt;= 10 THEN &quot;C&quot; ELSEIF [Calculation_13039443474284552] &lt;= 18 THEN &quot;D&quot; ELSE &quot;E&quot; END' />
      </column>
      <column caption='shap_satfat_nova' datatype='real' name='[Calculation_13039443503923211]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([shap_satfat_nova])' />
      </column>
      <column caption='Total_UPF_Drivers' datatype='real' name='[Calculation_13039443761467406]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([shap_sugars_nova]) &#13;&#10;+ ZN([shap_sodium_nova]) &#13;&#10;+ ZN([shap_satfat_nova]) &#13;&#10;+ ZN([shap_additives_nova]) &#13;&#10;+ 0.00001' />
      </column>
      <column caption='Impact_Sugar_%' datatype='real' default-format='p0.00%' name='[Calculation_13039443761553423]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([shap_sugars_nova]) / [Calculation_13039443761467406]' />
