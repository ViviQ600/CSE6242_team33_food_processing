    <worksheet name='Nutritional Space'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='12'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_products' name='federated.1tjvipp1mqvyp916upkvw0hj7oht' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Param_Sugar_Cut' datatype='real' default-format='p0.00%' name='[Parameter 13039443461939200]' param-domain-type='range' role='measure' type='quantitative' value='0.050000000000000003'>
              <calculation class='tableau' formula='0.050000000000000003' />
              <range granularity='0.05' max='1.0' min='0.0' />
            </column>
            <column caption='Param_Sodium_Cut' datatype='real' default-format='p0.00%' name='[Parameter 13039443464347649]' param-domain-type='range' role='measure' type='quantitative' value='0.10000000000000001'>
              <calculation class='tableau' formula='0.10000000000000001' />
              <range granularity='0.05' max='0.5' min='0.0' />
            </column>
            <column caption='Param_SatFat_Cut' datatype='real' default-format='p0.00%' name='[Parameter 13039443466125314]' param-domain-type='range' role='measure' type='quantitative' value='0.0'>
              <calculation class='tableau' formula='0.0' />
              <range granularity='0.05' max='0.5' min='0.0' />
            </column>
            <column alias='Y' caption='Param_Remove_Emulsifiers' datatype='boolean' name='[Parameter 13039443466584067]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
              <aliases>
                <alias key='false' value='N' />
                <alias key='true' value='Y' />
              </aliases>
            </column>
            <column alias='Y' caption='Param_Remove_Sweeteners' datatype='boolean' name='[Parameter 13039443466829828]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
              <aliases>
                <alias key='false' value='N' />
                <alias key='true' value='Y' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1tjvipp1mqvyp916upkvw0hj7oht'>
            <column caption='Dynamic NOVA 4 Prob' datatype='real' name='[Calculation_13039443473338374]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(&#13;&#10;    0.0,&#13;&#10;    MIN(&#13;&#10;        1.0,&#13;&#10;        ZN([pred_nova4_prob]) &#13;&#10;        - (ZN([shap_sugars_nova]) * [Parameters].[Parameter 13039443461939200]) &#13;&#10;        - (ZN([shap_sodium_nova]) * [Parameters].[Parameter 13039443464347649]) &#13;&#10;        - (ZN([saturated-fat_100g] / 100.0 * 0.15) * [Parameters].[Parameter 13039443466125314]) &#13;&#10;        - (IF [Parameters].[Parameter 13039443466584067] THEN 0.15 * ZN([has_emulsifier]) ELSE 0.0 END) &#13;&#10;        - (IF [Parameters].[Parameter 13039443466829828] THEN 0.12 * ZN([has_sweetener]) ELSE 0.0 END)&#13;&#10;    )&#13;&#10;)' />
            </column>
            <column caption='Dynamic NOVA Group' datatype='string' name='[Calculation_13039443474153479]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_13039443473338374] &lt;= 0.20 THEN &quot;NOVA 1 (Unprocessed/Minimally Processed)&quot;&#13;&#10;ELSEIF [Calculation_13039443473338374] &lt;= 0.45 THEN &quot;NOVA 2 (Culinary Ingredients)&quot;&#13;&#10;ELSEIF [Calculation_13039443473338374] &lt;= 0.68 THEN &quot;NOVA 3 (Processed Foods)&quot;&#13;&#10;ELSE &quot;NOVA 4 (Ultra-Processed)&quot;&#13;&#10;END' />
            </column>
            <column caption='Dynamic Nutri-Score Points' datatype='real' name='[Calculation_13039443474284552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([nutriscore_score_final]) &#13;&#10;- (ZN([nutri_sugar_penalty_pts]) * [Parameters].[Parameter 13039443461939200]) &#13;&#10;- (ZN([nutri_sodium_penalty_pts]) * [Parameters].[Parameter 13039443464347649]) &#13;&#10;- (ZN([saturated-fat_100g] / 1.0) * [Parameters].[Parameter 13039443466125314])' />
            </column>
            <column caption='Dynamic Nutri-Score Grade' datatype='string' name='[Calculation_13039443474423817]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_13039443474284552] &lt;= -1 THEN &quot;A&quot;&#13;&#10;ELSEIF [Calculation_13039443474284552] &lt;= 2 THEN &quot;B&quot;&#13;&#10;ELSEIF [Calculation_13039443474284552] &lt;= 10 THEN &quot;C&quot;&#13;&#10;ELSEIF [Calculation_13039443474284552] &lt;= 18 THEN &quot;D&quot;&#13;&#10;ELSE &quot;E&quot;&#13;&#10;END' />
            </column>
            <column caption='Additives N' datatype='real' name='[additives_n]' role='measure' type='quantitative' />
            <column-instance column='[pred_nova_group]' derivation='Attribute' name='[attr:pred_nova_group:ok]' pivot='key' type='ordinal' />
            <column-instance column='[additives_n]' derivation='Avg' name='[avg:additives_n:qk]' pivot='key' type='quantitative' />
            <column caption='Has Emulsifier' datatype='integer' name='[has_emulsifier]' role='measure' type='quantitative' />
            <column caption='Has Sweetener' datatype='integer' name='[has_sweetener]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_13039443474153479]' derivation='None' name='[none:Calculation_13039443474153479:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_13039443474423817]' derivation='None' name='[none:Calculation_13039443474423817:nk]' pivot='key' type='nominal' />
            <column-instance column='[product_name]' derivation='None' name='[none:product_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[sub_category]' derivation='None' name='[none:sub_category:nk]' pivot='key' type='nominal' />
            <column-instance column='[unified_category]' derivation='None' name='[none:unified_category:nk]' pivot='key' type='nominal' />
            <column caption='Nutri Sodium Penalty Pts' datatype='real' name='[nutri_sodium_penalty_pts]' role='measure' type='quantitative' />
            <column caption='Nutri Sugar Penalty Pts' datatype='real' name='[nutri_sugar_penalty_pts]' role='measure' type='quantitative' />
            <column caption='Nutriscore Score Final' datatype='real' name='[nutriscore_score_final]' role='measure' type='quantitative' />
            <column caption='Pred Nova4 Prob' datatype='real' name='[pred_nova4_prob]' role='measure' type='quantitative' />
            <column caption='Pred Nova Group' datatype='integer' name='[pred_nova_group]' role='measure' type='ordinal' />
            <column caption='Product Name' datatype='string' name='[product_name]' role='dimension' type='nominal' />
            <column caption='Saturated-Fat 100G' datatype='real' name='[saturated-fat_100g]' role='measure' type='quantitative' />
            <column caption='Shap Sodium Nova' datatype='real' name='[shap_sodium_nova]' role='measure' type='quantitative' />
            <column caption='Shap Sugars Nova' datatype='real' name='[shap_sugars_nova]' role='measure' type='quantitative' />
            <column caption='Sodium 100G' datatype='real' name='[sodium_100g]' role='measure' type='quantitative' />
            <column caption='Sub Category' datatype='string' name='[sub_category]' role='dimension' type='nominal' />
            <column caption='Sugars 100G' datatype='real' name='[sugars_100g]' role='measure' type='quantitative' />
            <column-instance column='[sodium_100g]' derivation='Sum' name='[sum:sodium_100g:qk]' pivot='key' type='quantitative' />
            <column-instance column='[sugars_100g]' derivation='Sum' name='[sum:sugars_100g:qk]' pivot='key' type='quantitative' />
            <column caption='Unified Category' datatype='string' name='[unified_category]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1tjvipp1mqvyp916upkvw0hj7oht].[none:product_name:nk]' filter-group='3'>
            <groupfilter function='member' level='[none:product_name:nk]' member='&quot;7 select Farmers grove orange juice&quot;' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
