      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_products' name='federated.1tjvipp1mqvyp916upkvw0hj7oht' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Keep' caption='Preservatives' datatype='boolean' name='[Param_Remove_Emulsifiers (copy)_13039443832381461]' param-domain-type='list' role='measure' type='nominal' value='false'>
              <calculation class='tableau' formula='false' />
              <aliases>
                <alias key='false' value='Keep' />
                <alias key='true' value='Remove' />
              </aliases>
            </column>
            <column alias='Keep' caption='Artificial Color' datatype='boolean' name='[Param_Remove_Emulsifiers (copy)_13039443832819737]' param-domain-type='list' role='measure' type='nominal' value='false'>
              <calculation class='tableau' formula='false' />
              <aliases>
                <alias key='false' value='Keep' />
                <alias key='true' value='Remove' />
              </aliases>
            </column>
            <column alias='Keep' caption='Flavor Enhancers' datatype='boolean' name='[Param_Remove_Preservatives (copy)_13039443832676375]' param-domain-type='list' role='measure' type='nominal' value='false'>
              <calculation class='tableau' formula='false' />
              <aliases>
                <alias key='false' value='Keep' />
                <alias key='true' value='Remove' />
              </aliases>
            </column>
            <column caption='Sugar Cut %' datatype='real' default-format='p0.00%' name='[Parameter 13039443461939200]' param-domain-type='range' role='measure' type='quantitative' value='0.0'>
              <calculation class='tableau' formula='0.0' />
              <range granularity='0.05' max='1.0' min='0.0' />
            </column>
            <column caption='Sodium Cut %' datatype='real' default-format='p0.00%' name='[Parameter 13039443464347649]' param-domain-type='range' role='measure' type='quantitative' value='0.0'>
              <calculation class='tableau' formula='0.0' />
              <range granularity='0.05' max='0.5' min='0.0' />
            </column>
            <column caption='Sat. Fat Cut %' datatype='real' default-format='p0.00%' name='[Parameter 13039443466125314]' param-domain-type='range' role='measure' type='quantitative' value='0.0'>
              <calculation class='tableau' formula='0.0' />
              <range granularity='0.05' max='0.5' min='0.0' />
            </column>
            <column alias='Keep' caption='Emulsifiers' datatype='boolean' name='[Parameter 13039443466584067]' param-domain-type='list' role='measure' type='nominal' value='false'>
              <calculation class='tableau' formula='false' />
              <aliases>
                <alias key='false' value='Keep' />
                <alias key='true' value='Remove' />
              </aliases>
            </column>
            <column alias='Keep' caption='Sweeteners' datatype='boolean' name='[Parameter 13039443466829828]' param-domain-type='list' role='measure' type='nominal' value='false'>
              <calculation class='tableau' formula='false' />
              <aliases>
                <alias key='false' value='Keep' />
                <alias key='true' value='Remove' />
              </aliases>
            </column>
            <column caption='Param_NOVA4_Threshold' datatype='real' name='[Parameter 13039443833724957]' param-domain-type='range' role='measure' type='quantitative' value='0.45556416433671104'>
              <calculation class='tableau' formula='0.45556416433671104' />
              <range max='1.0' min='0.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1tjvipp1mqvyp916upkvw0hj7oht'>
            <column caption='Dynamic NOVA 4 Prob' datatype='real' name='[Calculation_13039443473338374]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(0.0, MIN(1.0, ZN([pred_nova4_prob]) - (ZN([shap_sugars_nova]) * [Parameters].[Parameter 13039443461939200]) - (ZN([shap_sodium_nova]) * [Parameters].[Parameter 13039443464347649]) - (ZN([shap_satfat_nova]) * [Parameters].[Parameter 13039443466125314]) - (IF [Parameters].[Parameter 13039443466584067] THEN 0.1677712350655815 * ZN([has_emulsifier]) ELSE 0.0 END) - (IF [Parameters].[Parameter 13039443466829828] THEN 0.03033125115521329 * ZN([has_sweetener]) ELSE 0.0 END) - (IF [Parameters].[Param_Remove_Emulsifiers (copy)_13039443832381461] THEN 0.02326274703741176 * ZN([has_preservative]) ELSE 0.0 END) - (IF [Parameters].[Param_Remove_Preservatives (copy)_13039443832676375] THEN 0.09077031125379285 * ZN([has_flavor_enhancer]) ELSE 0.0 END) - (IF [Parameters].[Param_Remove_Emulsifiers (copy)_13039443832819737] THEN 0.09122154489674218 * ZN([has_artificial_color]) ELSE 0.0 END)))' />
            </column>
            <column caption='Dynamic NOVA Group' datatype='string' name='[Calculation_13039443474153479]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 13039443461939200] = 0 AND [Parameters].[Parameter 13039443464347649] = 0 AND [Parameters].[Parameter 13039443466125314] = 0 AND [Parameters].[Parameter 13039443466584067] = FALSE AND [Parameters].[Parameter 13039443466829828] = FALSE AND [Parameters].[Param_Remove_Emulsifiers (copy)_13039443832381461] = FALSE AND [Parameters].[Param_Remove_Emulsifiers (copy)_13039443832819737] = FALSE AND [Parameters].[Param_Remove_Preservatives (copy)_13039443832676375] = FALSE THEN IF [pred_nova_group] = 1 THEN &quot;NOVA 1 (Unprocessed)&quot; ELSEIF [pred_nova_group] = 2 THEN &quot;NOVA 2 (Culinary)&quot; ELSEIF [pred_nova_group] = 3 THEN &quot;NOVA 3 (Processed)&quot; ELSE &quot;NOVA 4 (Ultra-Processed)&quot; END ELSEIF [Calculation_13039443473338374] &gt;= [Parameters].[Parameter 13039443833724957] THEN &quot;NOVA 4 (Ultra-Processed)&quot; ELSEIF [pred_nova_group] = 1 THEN &quot;NOVA 1 (Unprocessed)&quot; ELSEIF [pred_nova_group] = 2 THEN &quot;NOVA 2 (Culinary)&quot; ELSE &quot;NOVA 3 (Processed)&quot; END' />
            </column>
            <column caption='Sugars (g/100 g)' datatype='real' name='[Calculation_2603981053747203]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([sugars_100g]) * (1 - [Parameters].[Parameter 13039443461939200])' />
