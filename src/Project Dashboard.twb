            </groupfilter>
          </filter>
          <manual-sort column='[federated.1tjvipp1mqvyp916upkvw0hj7oht].[:Measure Names]' direction='ASC'>
            <dictionary>
              <bucket>&quot;[federated.1tjvipp1mqvyp916upkvw0hj7oht].[avg:has_artificial_color:qk]&quot;</bucket>
              <bucket>&quot;[federated.1tjvipp1mqvyp916upkvw0hj7oht].[avg:has_preservative:qk]&quot;</bucket>
