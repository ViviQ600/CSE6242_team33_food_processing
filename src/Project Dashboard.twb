    <worksheet name='Reformulation KPI Scorecard'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='12'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_products' name='federated.1tjvipp1mqvyp916upkvw0hj7oht' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Param_Sugar_Cut' datatype='real' default-format='p0.00%' name='[Parameter 13039443461939200]' param-domain-type='range' role='measure' type='quantitative' value='0.0'>
              <calculation class='tableau' formula='0.0' />
              <range granularity='0.05' max='0.5' min='0.0' />
            </column>
            <column caption='Param_Sodium_Cut' datatype='real' default-format='p0.00%' name='[Parameter 13039443464347649]' param-domain-type='range' role='measure' type='quantitative' value='0.0'>
              <calculation class='tableau' formula='0.0' />
              <range granularity='0.05' max='0.5' min='0.0' />
            </column>
            <column caption='Param_SatFat_Cut' datatype='real' default-format='p0.00%' name='[Parameter 13039443466125314]' param-domain-type='range' role='measure' type='quantitative' value='0.'>
              <calculation class='tableau' formula='0.' />
              <range granularity='0.05' max='0.5' min='0.0' />
            </column>
            <column alias='Y' caption='Param_Remove_Emulsifiers' datatype='boolean' name='[Parameter 13039443466584067]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
              <aliases>
                <alias key='false' value='N' />
                <alias key='true' value='Y' />
              </aliases>
            </column>
            <column alias='Y' caption='Param_Remove_Sweeteners' datatype='boolean' name='[Parameter 13039443466829828]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
              <aliases>
                <alias key='false' value='N' />
                <alias key='true' value='Y' />
              </aliases>
            </column>
            <column caption='Param_NOVA4_Threshold' datatype='real' name='[Parameter 13039443833724957]' param-domain-type='range' role='measure' type='quantitative' value='0.68'>
              <calculation class='tableau' formula='0.68' />
              <range max='0.8' min='0.3' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1tjvipp1mqvyp916upkvw0hj7oht'>
            <column caption='Simulated_NOVA_Prob' datatype='real' name='[Calculation_13039443834044446]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 / (1 + EXP(-(&#13;&#10;    ([sugars_100g] * (1 - [Parameters].[Parameter 13039443461939200]) * 0.045)&#13;&#10;    + ([sodium_100g] * (1 - [Parameters].[Parameter 13039443464347649]) * 0.95)&#13;&#10;    + ([saturated-fat_100g] * (1 - [Parameters].[Parameter 13039443466125314]) * 0.06)&#13;&#10;    + ([additives_n] * 0.35)&#13;&#10;    + (IF [Parameters].[Parameter 13039443466584067] THEN 0 ELSE [has_emulsifier] END * 0.65)&#13;&#10;    + (IF [Parameters].[Parameter 13039443466829828] THEN 0 ELSE [has_sweetener] END * 0.55)&#13;&#10;    - ([fiber_100g] * 0.12)&#13;&#10;    - 2.10&#13;&#10;)))' />
            </column>
            <column caption='Simulated_Nutri_Grade' datatype='string' name='[Calculation_13039443834179615]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([nutriscore_score_final] - ([sugars_100g] * [Parameters].[Parameter 13039443461939200] / 4.5) - ([sodium_100g] * [Parameters].[Parameter 13039443464347649] / 0.09)) &lt;= -1 THEN &quot;A&quot;&#13;&#10;ELSEIF ([nutriscore_score_final] - ([sugars_100g] * [Parameters].[Parameter 13039443461939200] / 4.5) - ([sodium_100g] * [Parameters].[Parameter 13039443464347649] / 0.09)) &lt;= 2 THEN &quot;B&quot;&#13;&#10;ELSEIF ([nutriscore_score_final] - ([sugars_100g] * [Parameters].[Parameter 13039443461939200] / 4.5) - ([sodium_100g] * [Parameters].[Parameter 13039443464347649] / 0.09)) &lt;= 10 THEN &quot;C&quot;&#13;&#10;ELSEIF ([nutriscore_score_final] - ([sugars_100g] * [Parameters].[Parameter 13039443461939200] / 4.5) - ([sodium_100g] * [Parameters].[Parameter 13039443464347649] / 0.09)) &lt;= 18 THEN &quot;D&quot;&#13;&#10;ELSE &quot;E&quot;&#13;&#10;END' />
            </column>
            <column caption='Reformulation_Status' datatype='string' name='[Calculation_13039443840737313]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_13039443834044446] &lt; 0.45 AND [Calculation_13039443834179615] IN (&quot;A&quot;, &quot;B&quot;) THEN&#13;&#10;    &quot;🟢 HEALTHY BENCHMARK&quot;&#13;&#10;ELSEIF [Calculation_13039443834044446] &lt; [Parameters].[Parameter 13039443833724957] THEN&#13;&#10;    &quot;🟡 PARTIAL REFORMULATION&quot;&#13;&#10;ELSE&#13;&#10;    &quot;🔴 ULTRA-PROCESSED&quot;&#13;&#10;END' />
            </column>
            <column caption='Additives N' datatype='real' name='[additives_n]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_13039443834044446]' derivation='Avg' name='[avg:Calculation_13039443834044446:qk]' pivot='key' type='quantitative' />
            <column caption='Fiber 100G' datatype='real' name='[fiber_100g]' role='measure' type='quantitative' />
            <column caption='Has Emulsifier' datatype='integer' name='[has_emulsifier]' role='measure' type='quantitative' />
            <column caption='Has Sweetener' datatype='integer' name='[has_sweetener]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_13039443834179615]' derivation='Max' name='[max:Calculation_13039443834179615:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_13039443840737313]' derivation='Max' name='[max:Calculation_13039443840737313:nk]' pivot='key' type='nominal' />
            <column-instance column='[unified_category]' derivation='None' name='[none:unified_category:nk]' pivot='key' type='nominal' />
            <column caption='Nutriscore Score Final' datatype='real' name='[nutriscore_score_final]' role='measure' type='quantitative' />
            <column caption='Saturated-Fat 100G' datatype='real' name='[saturated-fat_100g]' role='measure' type='quantitative' />
            <column caption='Sodium 100G' datatype='real' name='[sodium_100g]' role='measure' type='quantitative' />
            <column caption='Sugars 100G' datatype='real' name='[sugars_100g]' role='measure' type='quantitative' />
            <column caption='Unified Category' datatype='string' name='[unified_category]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <slices>
            <column>[federated.1tjvipp1mqvyp916upkvw0hj7oht].[none:unified_category:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='text-align' field='[federated.1tjvipp1mqvyp916upkvw0hj7oht].[avg:Calculation_13039443834044446:qk]' value='center' />
            <format attr='vertical-align' field='[federated.1tjvipp1mqvyp916upkvw0hj7oht].[avg:Calculation_13039443834044446:qk]' value='center' />
