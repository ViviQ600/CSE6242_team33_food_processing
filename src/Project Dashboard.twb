            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1tjvipp1mqvyp916upkvw0hj7oht'>
            <column caption='Reformulation_Status' datatype='string' name='[Calculation_13039443840737313]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Parameters].[Parameter 13039443461939200] + [Parameters].[Parameter 13039443464347649] + [Parameters].[Parameter 13039443466125314]) &gt;= 0.80 THEN &quot;⚠️ OVER-CUT ALERT&quot; ELSEIF AVG([Calculation_13039443473338374]) &lt; 0.40 AND (IF AVG([Calculation_13039443474284552]) &lt;= -1 THEN &quot;A&quot; ELSEIF AVG([Calculation_13039443474284552]) &lt;= 2 THEN &quot;B&quot; ELSEIF AVG([Calculation_13039443474284552]) &lt;= 10 THEN &quot;C&quot; ELSEIF AVG([Calculation_13039443474284552]) &lt;= 18 THEN &quot;D&quot; ELSE &quot;E&quot; END) IN (&quot;A&quot;, &quot;B&quot;) THEN &quot;🟢 HEALTHY BENCHMARK&quot; ELSEIF AVG([Calculation_13039443473338374]) &lt; [Parameters].[Parameter 13039443833724957] THEN &quot;🟡 PARTIAL REFORMULATION&quot; ELSE &quot;🔴 ULTRA-PROCESSED&quot; END' />
            </column>
            <column caption='Additives N' datatype='real' name='[additives_n]' role='measure' type='quantitative' />
            <column caption='Code' datatype='integer' name='[code]' role='dimension' type='ordinal' />
            <column caption='Fiber 100G' datatype='real' name='[fiber_100g]' role='measure' type='quantitative' />
            <column caption='Has Emulsifier' datatype='integer' name='[has_emulsifier]' role='measure' type='quantitative' />
            <column datatype='integer' name='[has_flavor_enhancer]' role='measure' type='quantitative' />
            <column datatype='integer' name='[has_preservative]' role='measure' type='quantitative' />
            <column caption='Has Sweetener' datatype='integer' name='[has_sweetener]' role='measure' type='quantitative' />
            <column-instance column='[product_name]' derivation='Min' name='[min:product_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[code]' derivation='None' name='[none:code:nk]' pivot='key' type='ordinal' />
            <column-instance column='[product_name]' derivation='None' name='[none:product_name:nk]' pivot='key' type='nominal' />
            <column caption='Nutriscore Score Final' datatype='real' name='[nutriscore_score_final]' role='measure' type='quantitative' />
            <column caption='Product Name' datatype='string' name='[product_name]' role='dimension' type='nominal' />
            <column caption='Saturated-Fat 100G' datatype='real' name='[saturated-fat_100g]' role='measure' type='quantitative' />
            <column caption='Sodium 100G' datatype='real' name='[sodium_100g]' role='measure' type='quantitative' />
            <column caption='Sugars 100G' datatype='real' name='[sugars_100g]' role='measure' type='quantitative' />
          <column caption='Unified Category' datatype='string' name='[unified_category]' role='dimension' type='nominal' />
            <column-instance column='[unified_category]' derivation='None' name='[none:unified_category:nk]' pivot='key' type='nominal' />
            <column caption='Sub Category' datatype='string' name='[sub_category]' role='dimension' type='nominal' />
            <column-instance column='[sub_category]' derivation='None' name='[none:sub_category:nk]' pivot='key' type='nominal' />
            <column caption='Dynamic NOVA 4 Prob' datatype='real' name='[Calculation_13039443473338374]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(0.0, MIN(1.0, ZN([pred_nova4_prob]) - (ZN([shap_sugars_nova]) * [Parameters].[Parameter 13039443461939200]) - (ZN([shap_sodium_nova]) * [Parameters].[Parameter 13039443464347649]) - (ZN([shap_satfat_nova]) * [Parameters].[Parameter 13039443466125314]) - (IF [Parameters].[Parameter 13039443466584067] THEN 0.20877546496580834 * ZN([has_emulsifier]) ELSE 0.0 END) - (IF [Parameters].[Parameter 13039443466829828] THEN 0.05161728063032965 * ZN([has_sweetener]) ELSE 0.0 END) - (IF [Parameters].[Param_Remove_Emulsifiers (copy)_13039443832381461] THEN 0.019974718949425197 * ZN([has_preservative]) ELSE 0.0 END) - (IF [Parameters].[Param_Remove_Preservatives (copy)_13039443832676375] THEN 0.10629109736221067 * ZN([has_flavor_enhancer]) ELSE 0.0 END)))' />
            </column>
            <column caption='Dynamic Nutri-Score Points' datatype='real' name='[Calculation_13039443474284552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([nutriscore_score_final]) &#13;&#10;- (ZN([nutri_sugar_penalty_pts]) * [Parameters].[Parameter 13039443461939200]) &#13;&#10;- (ZN([nutri_sodium_penalty_pts]) * [Parameters].[Parameter 13039443464347649]) &#13;&#10;- (ZN([saturated-fat_100g] / 1.0) * [Parameters].[Parameter 13039443466125314])' />
            </column>
            <column-instance column='[Calculation_13039443473338374]' derivation='Avg' name='[avg:Calculation_13039443473338374:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_13039443840737313]' derivation='User' name='[usr:Calculation_13039443840737313:nk]' pivot='key' type='nominal' />
                        <column caption='Pred Nova4 Prob' datatype='real' name='[pred_nova4_prob]' role='measure' type='quantitative' />
                        <column caption='Nutriscore Grade Final' datatype='string' name='[nutriscore_grade_final]' role='dimension' type='nominal' />
                        <column caption='Nutriscore Provenance' datatype='string' name='[nutriscore_provenance]' role='dimension' type='nominal' />

            <column caption='KPI Product Header' datatype='string' name='[Calculation_202611020001]' role='dimension' type='nominal'><calculation class='tableau' formula='IF COUNTD([code]) &gt; 1 THEN &quot;Category Average&quot; ELSE IFNULL(MIN([product_name]), &quot;Unknown Product&quot;) END' /></column>
            <column caption='KPI NOVA Probability Comparison' datatype='string' name='[Calculation_202611020002]' role='dimension' type='nominal'><calculation class='tableau' formula='&quot;NOVA 4 Prob: &quot; + STR(ROUND(AVG([pred_nova4_prob]) * 100, 1)) + &quot;% -&gt; &quot; + STR(ROUND(AVG([Calculation_13039443473338374]) * 100, 1)) + &quot;%&quot;' /></column>
            <column caption='KPI Nutri-Score Comparison' datatype='string' name='[Calculation_202611020003]' role='dimension' type='nominal'><calculation class='tableau' formula='&quot;Nutri-Score: &quot; + (IF COUNTD([nutriscore_grade_final]) &gt; 1 THEN &quot;Mixed&quot; ELSE IFNULL(MIN([nutriscore_grade_final]), &quot;Unknown&quot;) END) + &quot; -&gt; &quot; + (IF AVG([Calculation_13039443474284552]) &lt;= -1 THEN &quot;A&quot; ELSEIF AVG([Calculation_13039443474284552]) &lt;= 2 THEN &quot;B&quot; ELSEIF AVG([Calculation_13039443474284552]) &lt;= 10 THEN &quot;C&quot; ELSEIF AVG([Calculation_13039443474284552]) &lt;= 18 THEN &quot;D&quot; ELSE &quot;E&quot; END)' /></column>
            <column caption='KPI Grade Source' datatype='string' name='[Calculation_202611020004]' role='dimension' type='nominal'><calculation class='tableau' formula='&quot;Grade Source: &quot; + (IF COUNTD([nutriscore_provenance]) &gt; 1 THEN &quot;Mixed&quot; ELSE IFNULL(MIN([nutriscore_provenance]), &quot;Unknown&quot;) END)' /></column>
            <column-instance column='[Calculation_202611020001]' derivation='User' name='[usr:Calculation_202611020001:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_202611020002]' derivation='User' name='[usr:Calculation_202611020002:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_202611020003]' derivation='User' name='[usr:Calculation_202611020003:nk]' pivot='key' type='nominal' />
