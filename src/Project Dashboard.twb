      <column caption='Impact_SatFat_%' datatype='real' default-format='p0.00%' name='[Calculation_13039443762098193]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([shap_satfat_nova]) / [Calculation_13039443761467406]' />
      </column>
      <column caption='Impact_Additives_%' datatype='real' default-format='p0.00%' name='[Calculation_13039443762327570]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([shap_additives_nova]) / [Calculation_13039443761467406]' />
      </column>
      <column caption='Reformulation_Status' datatype='string' name='[Calculation_13039443840737313]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([Parameters].[Parameter 13039443461939200] + [Parameters].[Parameter 13039443464347649] + [Parameters].[Parameter 13039443466125314]) &gt;= 0.80 THEN &quot;⚠️ OVER-CUT ALERT&quot; ELSEIF AVG([Calculation_13039443473338374]) &lt; 0.40 AND (IF AVG([Calculation_13039443474284552]) &lt;= -1 THEN &quot;A&quot; ELSEIF AVG([Calculation_13039443474284552]) &lt;= 2 THEN &quot;B&quot; ELSEIF AVG([Calculation_13039443474284552]) &lt;= 10 THEN &quot;C&quot; ELSEIF AVG([Calculation_13039443474284552]) &lt;= 18 THEN &quot;D&quot; ELSE &quot;E&quot; END) IN (&quot;A&quot;, &quot;B&quot;) THEN &quot;🟢 HEALTHY BENCHMARK&quot; ELSEIF AVG([Calculation_13039443473338374]) &lt; [Parameters].[Parameter 13039443833724957] THEN &quot;🟡 PARTIAL REFORMULATION&quot; ELSE &quot;🔴 ULTRA-PROCESSED&quot; END' />
      </column>

      <column caption='KPI Product Header' datatype='string' name='[Calculation_202611020001]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF COUNTD([code]) &gt; 1 THEN &quot;Category Average&quot; ELSE IFNULL(MIN([product_name]), &quot;Unknown Product&quot;) END' />
      </column>
      <column caption='KPI NOVA Probability Comparison' datatype='string' name='[Calculation_202611020002]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;NOVA 4 Prob: &quot; + STR(ROUND(AVG([pred_nova4_prob]) * 100, 1)) + &quot;% -&gt; &quot; + STR(ROUND(AVG([Calculation_13039443473338374]) * 100, 1)) + &quot;%&quot;' />
      </column>
      <column caption='KPI Nutri-Score Comparison' datatype='string' name='[Calculation_202611020003]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Nutri-Score: &quot; + (IF COUNTD([nutriscore_grade_final]) &gt; 1 THEN &quot;Mixed&quot; ELSE IFNULL(MIN([nutriscore_grade_final]), &quot;Unknown&quot;) END) + &quot; -&gt; &quot; + (IF AVG([Calculation_13039443474284552]) &lt;= -1 THEN &quot;A&quot; ELSEIF AVG([Calculation_13039443474284552]) &lt;= 2 THEN &quot;B&quot; ELSEIF AVG([Calculation_13039443474284552]) &lt;= 10 THEN &quot;C&quot; ELSEIF AVG([Calculation_13039443474284552]) &lt;= 18 THEN &quot;D&quot; ELSE &quot;E&quot; END)' />
      </column>
      <column caption='KPI Grade Source' datatype='string' name='[Calculation_202611020004]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Grade Source: &quot; + (IF COUNTD([nutriscore_provenance]) &gt; 1 THEN &quot;Mixed&quot; ELSE IFNULL(MIN([nutriscore_provenance]), &quot;Unknown&quot;) END)' />
      </column>
      <column caption='Rank_Lowest_Sugar' datatype='integer' name='[Calculation_13039443854987298]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_DENSE(AVG([sugars_100g]), &apos;asc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Sugars (g/100 g)' datatype='real' name='[Calculation_2603981053747203]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([sugars_100g]) * (1 - [Parameters].[Parameter 13039443461939200])' />
