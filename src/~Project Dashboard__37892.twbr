      <column caption='Dynamic NOVA 4 Prob' datatype='real' name='[Calculation_13039443473338374]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX(&#13;&#10;    0.0,&#13;&#10;    MIN(&#13;&#10;        1.0,&#13;&#10;        ZN([pred_nova4_prob]) &#13;&#10;        - (ZN([shap_sugars_nova]) * [Parameters].[Parameter 13039443461939200]) &#13;&#10;        - (ZN([shap_sodium_nova]) * [Parameters].[Parameter 13039443464347649]) &#13;&#10;        - (ZN([saturated-fat_100g] / 100.0 * 0.15) * [Parameters].[Parameter 13039443466125314]) &#13;&#10;        - (IF [Parameters].[Parameter 13039443466584067] THEN 0.15 * ZN([has_emulsifier]) ELSE 0.0 END) &#13;&#10;        - (IF [Parameters].[Parameter 13039443466829828] THEN 0.12 * ZN([has_sweetener]) ELSE 0.0 END)&#13;&#10;    )&#13;&#10;)' />
      </column>
      <column caption='Dynamic NOVA Group' datatype='string' name='[Calculation_13039443474153479]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_13039443473338374] &lt;= 0.20 THEN &quot;NOVA 1 (Unprocessed/Minimally Processed)&quot;&#13;&#10;ELSEIF [Calculation_13039443473338374] &lt;= 0.45 THEN &quot;NOVA 2 (Culinary Ingredients)&quot;&#13;&#10;ELSEIF [Calculation_13039443473338374] &lt;= 0.68 THEN &quot;NOVA 3 (Processed Foods)&quot;&#13;&#10;ELSE &quot;NOVA 4 (Ultra-Processed)&quot;&#13;&#10;END' />
      </column>
      <column caption='Dynamic Nutri-Score Points' datatype='real' name='[Calculation_13039443474284552]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([nutriscore_score_final]) &#13;&#10;- (ZN([nutri_sugar_penalty_pts]) * [Parameters].[Parameter 13039443461939200]) &#13;&#10;- (ZN([nutri_sodium_penalty_pts]) * [Parameters].[Parameter 13039443464347649]) &#13;&#10;- (ZN([saturated-fat_100g] / 1.0) * [Parameters].[Parameter 13039443466125314])' />
      </column>
      <column caption='Dynamic Nutri-Score Grade' datatype='string' name='[Calculation_13039443474423817]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_13039443474284552] &lt;= -1 THEN &quot;A&quot;&#13;&#10;ELSEIF [Calculation_13039443474284552] &lt;= 2 THEN &quot;B&quot;&#13;&#10;ELSEIF [Calculation_13039443474284552] &lt;= 10 THEN &quot;C&quot;&#13;&#10;ELSEIF [Calculation_13039443474284552] &lt;= 18 THEN &quot;D&quot;&#13;&#10;ELSE &quot;E&quot;&#13;&#10;END' />
      </column>
      <column caption='Reformulation Status' datatype='string' name='[Calculation_13039443481366538]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([Parameters].[Parameter 13039443461939200] + [Parameters].[Parameter 13039443464347649] + [Parameters].[Parameter 13039443466125314]) &gt;= 0.80 THEN&#13;&#10;    &quot;[Over-cut Alert] Recipe integrity &amp; texture at risk&quot;&#13;&#10;ELSEIF [pred_nova_group] = 4 AND [Calculation_13039443473338374] &lt;= 0.45 THEN&#13;&#10;    &quot;[Pass] Successfully transitioned to Non-UPF tier&quot;&#13;&#10;ELSEIF [pred_nova_group] = 4 THEN&#13;&#10;    &quot;[In Progress] Still classified as Ultra-Processed&quot;&#13;&#10;ELSE&#13;&#10;    &quot;[Baseline] Naturally clean-label product&quot;&#13;&#10;END' />
      </column>
      <column caption='shap_satfat_nova' datatype='real' name='[Calculation_13039443503923211]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([saturated-fat_100g] / 100.0 * 0.15)' />
      </column>
      <column caption='Total_UPF_Drivers' datatype='real' name='[Calculation_13039443761467406]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([shap_sugars_nova]) &#13;&#10;+ ZN([shap_sodium_nova]) &#13;&#10;+ ZN([saturated-fat_100g] / 100.0 * 0.15) &#13;&#10;+ ZN([shap_additives_nova]) &#13;&#10;+ 0.00001' />
      </column>
      <column caption='Impact_Sugar_%' datatype='real' default-format='p0.00%' name='[Calculation_13039443761553423]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([shap_sugars_nova]) / [Calculation_13039443761467406]' />
      </column>
      <column caption='Impact_Sodium_%' datatype='real' default-format='p0.00%' name='[Calculation_13039443761823760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([shap_sodium_nova]) / [Calculation_13039443761467406]' />
      </column>
      <column caption='Impact_SatFat_%' datatype='real' default-format='p0.00%' name='[Calculation_13039443762098193]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([saturated-fat_100g] / 100.0 * 0.15) / [Calculation_13039443761467406]' />
      </column>
      <column caption='Impact_Additives_%' datatype='real' default-format='p0.00%' name='[Calculation_13039443762327570]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([shap_additives_nova]) / [Calculation_13039443761467406]' />
      </column>
      <column caption='Simulated_NOVA_Prob' datatype='real' name='[Calculation_13039443834044446]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 / (1 + EXP(-(&#13;&#10;    ([sugars_100g] * (1 - [Parameters].[Parameter 13039443461939200]) * 0.045)&#13;&#10;    + ([sodium_100g] * (1 - [Parameters].[Parameter 13039443464347649]) * 0.95)&#13;&#10;    + ([saturated-fat_100g] * (1 - [Parameters].[Parameter 13039443466125314]) * 0.06)&#13;&#10;    + ([additives_n] * 0.35)&#13;&#10;    + (IF [Parameters].[Parameter 13039443466584067] THEN 0 ELSE [has_emulsifier] END * 0.65)&#13;&#10;    + (IF [Parameters].[Parameter 13039443466829828] THEN 0 ELSE [has_sweetener] END * 0.55)&#13;&#10;    - ([fiber_100g] * 0.12)&#13;&#10;    - 2.10&#13;&#10;)))' />
      </column>
      <column caption='Simulated_Nutri_Grade' datatype='string' name='[Calculation_13039443834179615]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([nutriscore_score_final] - ([sugars_100g] * [Parameters].[Parameter 13039443461939200] / 4.5) - ([sodium_100g] * [Parameters].[Parameter 13039443464347649] / 0.09)) &lt;= -1 THEN &quot;A&quot;&#13;&#10;ELSEIF ([nutriscore_score_final] - ([sugars_100g] * [Parameters].[Parameter 13039443461939200] / 4.5) - ([sodium_100g] * [Parameters].[Parameter 13039443464347649] / 0.09)) &lt;= 2 THEN &quot;B&quot;&#13;&#10;ELSEIF ([nutriscore_score_final] - ([sugars_100g] * [Parameters].[Parameter 13039443461939200] / 4.5) - ([sodium_100g] * [Parameters].[Parameter 13039443464347649] / 0.09)) &lt;= 10 THEN &quot;C&quot;&#13;&#10;ELSEIF ([nutriscore_score_final] - ([sugars_100g] * [Parameters].[Parameter 13039443461939200] / 4.5) - ([sodium_100g] * [Parameters].[Parameter 13039443464347649] / 0.09)) &lt;= 18 THEN &quot;D&quot;&#13;&#10;ELSE &quot;E&quot;&#13;&#10;END' />
      </column>
      <column caption='Reformulation_Status' datatype='string' name='[Calculation_13039443840737313]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_13039443834044446] &lt; 0.45 AND [Calculation_13039443834179615] IN (&quot;A&quot;, &quot;B&quot;) THEN&#13;&#10;    &quot;🟢 HEALTHY BENCHMARK&quot;&#13;&#10;ELSEIF [Calculation_13039443834044446] &lt; [Parameters].[Parameter 13039443833724957] THEN&#13;&#10;    &quot;🟡 PARTIAL REFORMULATION&quot;&#13;&#10;ELSE&#13;&#10;    &quot;🔴 ULTRA-PROCESSED&quot;&#13;&#10;END' />
      </column>
      <column caption='Rank_Lowest_Sugar' datatype='integer' name='[Calculation_13039443854987298]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_DENSE(AVG([sugars_100g]), &apos;asc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
